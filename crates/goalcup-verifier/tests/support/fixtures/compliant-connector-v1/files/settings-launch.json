{{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableAllHooks": false,
  "statusLine": {{
    "type": "command",
    "command": "cat {status_line_path}",
    "padding": 0
  }},
  "hooks": {{
    "UserPromptSubmit": [
      {{
        "hooks": [
          {{
            "type": "http",
            "url": "{receiver_http}/UserPromptSubmit",
            "headers": {{
              "X-GoalCup-Event": "UserPromptSubmit",
              "X-GoalCup-Token": "{receiver_token}",
              "X-GoalCup-Entry": "{entry_id}"
            }},
            "timeout": 5,
            "statusMessage": "goal-cup tracker"
          }}
        ]
      }}
    ],
    "UserPromptExpansion": [
      {{
        "matcher": "*",
        "hooks": [
          {{
            "type": "http",
