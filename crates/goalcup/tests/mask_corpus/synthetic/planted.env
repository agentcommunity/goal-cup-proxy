# A planted .env for the masking tests (PRD-05 section 10, PRD-12 section 5). Every value is a
# double-brace placeholder that tests/mask_corpus/synthetic.rs fills with a fake value built in
# code, so no committed file holds a contiguous key. AWS_SECRET_ACCESS_KEY has no shape: the
# default build does not mask it (owner question 3).
OPENAI_API_KEY={{openai}}
ANTHROPIC_API_KEY={{anthropic}}
GITHUB_TOKEN={{ghp}}
GH_FINE_GRAINED={{github_pat}}
AWS_ACCESS_KEY_ID={{akia}}
AWS_SECRET_ACCESS_KEY={{aws_secret}}
GOOGLE_API_KEY={{aiza}}
HF_TOKEN={{hf}}
XAI_API_KEY={{xai}}
GITLAB_TOKEN={{glpat}}
SESSION_JWT={{jwt}}
DATABASE_URL=postgres://app:{{db_password}}@db.internal:5432/app
API_KEY={{api_key}}
TOKEN={{token}}
AI_GATEWAY_API_KEY={{gateway}}
OPENROUTER_API_KEY={{openrouter}}
SIGNING_KEY="{{pem}}"
GEMINI_API_KEY={{google_auth}}
SERVICE_SECRET={{dotted}}
GROQ_API_KEY={{groq}}
CEREBRAS_API_KEY={{cerebras}}
FIREWORKS_API_KEY={{fireworks}}
TOGETHER_API_KEY={{together}}
AMP_API_KEY={{amp}}
FACTORY_API_KEY={{factory}}
