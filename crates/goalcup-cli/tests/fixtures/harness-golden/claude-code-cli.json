  "env_differs_from_policy": [],
  "goal_placement_for_an_option_shaped_goal": {
    "argv_len": 0,
    "goal_index": null,
    "goal_prefix": null,
    "tail": []
  },
  "home": {
    "kind": "shared",
    "per_run_tree": null
  },
  "plan": {
    "argv": [],
    "capture": null,
    "cwd": "<TMP>/workspace",
    "env_base_keys": [],
    "env_remove": [],
    "env_set": {
      "CLAUDE_CODE_RETRY_WATCHDOG": "1",
      "CLAUDE_CONFIG_DIR": "<TMP>/harness-home",
      "DISABLE_AUTOUPDATER": "1",
