{
  "connector": {
    "family": "claude-code",
    "id": "claude-code-cli"
  },
  "family_defers_its_scope": false,
  "kill": {
    "grace_seconds": 10,
    "native_binary": null,
    "strategy": "process_group"
  },
  "native_plan": {
    "controlled": [],
    "initial_binding": "AtLaunch",
    "scoped": {
      "form": "AppendOnly",
      "hint": "claude-code-jsonl",
      "name": "main",
      "pattern": "*/{id}.jsonl",
      "root": "<CONFIG_HOME>/projects",
      "scope_id": null
    },
    "unread_stores": 0
  },
  "native_plan_as_an_unknown_family": {
    "controlled": [],
    "initial_binding": "NotRequired",
    "scoped": null,
    "unread_stores": 2
  },
  "not_directly_pinned": {
    "Daemon::family_defers_its_scope": "pinned as `family_defers_its_scope` above (the same `binds` read); the connector-directory lookup around it is not",
    "registered_tool_allowance connector_id == claude-code-cli": "private, needs a registered verified process"
  },
  "shipped_source_row": {
    "binds": "AtLaunch",
    "spec": {
      "form": "AppendOnly",
      "hint": "claude-code-jsonl",
      "name": "main",
      "pattern": "*/{id}.jsonl",
      "root": "<CONFIG_HOME>/projects",
      "scope_id": null
    }
  },
  "v1_stores_as_the_native_plan_sees_them": [
    {
      "hint_for_family": "claude-code-jsonl",
      "mode": "jsonl",
      "name": "main",
      "path_template": "{config_dir}/projects/{slug}/{session_id}.jsonl"
    },
    {
      "hint_for_family": null,
      "mode": "dir",
      "name": "raw_bodies",
      "path_template": "{artifact_root}/raw-bodies/"
    }
  ]
}
