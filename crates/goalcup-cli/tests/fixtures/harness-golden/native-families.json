{
  "families": [
    "codex",
    "claude-code",
    "hermes",
    "controlled-workload",
    "opencode"
  ],
  "isolated_config_home": [
    {
      "probe": "home_itself",
      "verdict": "refused"
    },
    {
      "probe": "home_codex",
      "verdict": "refused"
    },
    {
      "probe": "home_codex_sessions",
      "verdict": "refused"
    },
    {
      "probe": "home_claude",
      "verdict": "refused"
    },
    {
      "probe": "home_claude_projects_x",
      "verdict": "refused"
    },
    {
      "probe": "home_hermes",
      "verdict": "refused"
    },
    {
      "probe": "home_hermes_nested_profile",
      "verdict": "refused"
    },
    {
      "probe": "home_cursor",
      "verdict": "ok"
    },
    {
      "probe": "home_other_dir",
      "verdict": "ok"
    },
    {
      "probe": "home_codex_lookalike",
      "verdict": "ok"
    },
    {
      "probe": "tmp_dir",
      "verdict": "ok"
    },
    {
      "probe": "tmp_dir_nested_missing",
      "verdict": "ok"
    },
    {
      "probe": "tmp_symlink_into_codex",
      "verdict": "refused"
    },
    {
      "probe": "tmp_symlink_into_hermes_profiles",
      "verdict": "refused"
    },
    {
      "probe": "relative",
      "verdict": "refused"
    },
    {
      "probe": "empty",
      "verdict": "refused"
    },
    {
      "probe": "parent_traversal",
      "verdict": "refused"
    },
    {
      "probe": "root",
      "verdict": "ok"
    }
  ],
  "isolated_config_home_literals": [
    ".codex",
    ".claude",
    ".hermes"
  ],
  "native_hint_for_store": [
    {
      "family": "codex",
      "hint": "codex-jsonl",
      "mode": "jsonl"
    },
    {
      "family": "codex",
      "hint": null,
      "mode": "dir"
    },
    {
      "family": "codex",
      "hint": null,
      "mode": "sqlite"
    },
    {
      "family": "claude-code",
      "hint": "claude-code-jsonl",
      "mode": "jsonl"
    },
    {
      "family": "claude-code",
      "hint": null,
      "mode": "dir"
    },
    {
      "family": "claude-code",
      "hint": null,
      "mode": "sqlite"
    },
    {
      "family": "hermes",
      "hint": null,
      "mode": "jsonl"
    },
    {
      "family": "hermes",
      "hint": null,
      "mode": "dir"
    },
    {
      "family": "hermes",
      "hint": null,
      "mode": "sqlite"
    },
    {
      "family": "controlled-workload",
      "hint": null,
      "mode": "jsonl"
    },
    {
      "family": "controlled-workload",
      "hint": null,
      "mode": "dir"
    },
    {
      "family": "controlled-workload",
      "hint": null,
      "mode": "sqlite"
    },
    {
      "family": "opencode",
      "hint": null,
      "mode": "jsonl"
    },
    {
      "family": "opencode",
      "hint": null,
      "mode": "dir"
    },
    {
      "family": "opencode",
      "hint": null,
      "mode": "sqlite"
    }
  ],
  "native_store_form_for_mode": [
    {
      "form": {
        "Ok": "AppendOnly"
      },
      "mode": "jsonl"
    },
    {
      "form": {
        "Ok": "Snapshot"
      },
      "mode": "dir"
    },
    {
      "form": {
        "Err": "native byte capture does not support SQLite stores"
      },
      "mode": "sqlite"
    }
  ],
  "scoped_native_source_by_family": [
    {
      "defers": false,
      "family": "codex",
      "scoped": {
        "binds": "AtLaunch",
        "spec": {
          "form": "AppendOnly",
          "hint": "codex-jsonl",
          "name": "rollout",
          "pattern": "*/*/*/rollout-*-{id}.jsonl",
          "root": "<CONFIG_HOME>/sessions",
          "scope_id": null
        }
      }
    },
    {
      "defers": false,
      "family": "claude-code",
      "scoped": {
        "binds": "AtLaunch",
        "spec": {
          "form": "AppendOnly",
          "hint": "claude-code-jsonl",
          "name": "main",
          "pattern": "*/{id}.jsonl",
          "root": "<CONFIG_HOME>/projects",
          "scope_id": null
        }
      }
    },
    {
      "defers": true,
      "family": "hermes",
      "scoped": {
        "binds": "Deferred",
        "spec": {
          "form": "Snapshot",
          "hint": null,
          "name": "session",
          "pattern": "session_{id}.json",
          "root": "<CONFIG_HOME>/sessions",
          "scope_id": null
        }
      }
    },
    {
      "defers": false,
      "family": "controlled-workload",
      "scoped": null
    },
    {
      "defers": false,
      "family": "opencode",
      "scoped": null
    }
  ]
}
