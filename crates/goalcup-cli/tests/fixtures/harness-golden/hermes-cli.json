    {
      "file": "proxy_ca",
      "mode": "replace",
      "name": "HERMES_CA_BUNDLE",
      "value_in_plan": "<TMP>/proxy-ca.pem"
    }
  ],
  "capture_profile": {
    "args": [
      "chat"
    ],
    "auth_hosts": [],
    "ca_env": [
      "HERMES_CA_BUNDLE"
    ],
    "config_home": "shared",
    "configure": [
      [
        "config",
        "set",
        "sessions.write_json_snapshots",
        "true"
      ],
      [
        "config",
        "set",
        "compression.in_place",
        "false"
      ]
    ],
    "continuation": "chat: the participant types the prompt and may type keep going",
    "env": {
      "TERMINAL_HOME_MODE": "profile"
    },
    "executable": {
      "version_args": []
    },
    "home": "empty",
    "hosts": [
      {
        "evidence_paths": [
          "/v1/chat/completions"
        ],
        "host": "api.deepseek.com",
        "prefix_paths": [],
        "protocol_hint": "openai-chat-completions"
      }
    ],
    "identity": {
      "binding": null,
      "grammar": null,
      "id_field": null,
      "match_field": null,
      "match_value": null,
      "prefix": null,
      "source": "none"
    },
    "interactive": true,
    "providers": [
      "deepseek"
    ],
    "resume_args": [
      "--continue"
    ],
    "skills_dir": null
  },
  "connector": {
    "dir_digest_matches_its_pin": true,
    "files_dir": [],
    "id": "hermes-cli",
    "launch_home_env": "HERMES_HOME",
    "launch_program": "hermes",
    "validates": "ok"
  },
  "env_differs_from_policy": [
    {
      "in_capture_env": "refused:capture.env",
      "name": "HERMES_X"
    }
  ],
  "goal_placement_for_an_option_shaped_goal": {
    "argv_len": 1,
    "goal_index": null,
    "goal_prefix": null,
    "tail": [
      "chat"
    ]
  },
  "home": {
    "kind": "shared",
    "per_run_tree": null
  },
  "plan": {
    "argv": [
      "chat"
    ],
    "capture": null,
    "cwd": "<TMP>/workspace",
    "env_base_keys": [],
    "env_remove": [],
    "env_set": {
      "HERMES_CA_BUNDLE": "<TMP>/proxy-ca.pem",
      "HERMES_HOME": "<TMP>/harness-home",
      "HOME": "<TMP>/run-home",
      "HTTPS_PROXY": "<PROXY_URL>",
      "LOGNAME": "participant",
      "NO_PROXY": "127.0.0.1,localhost",
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "TERMINAL_HOME_MODE": "profile",
      "TMPDIR": "/private/tmp/participant-tmp/",
      "USER": "participant",
      "https_proxy": "<PROXY_URL>",
      "no_proxy": "127.0.0.1,localhost"
    },
    "kill": {
      "grace_seconds": 10,
      "native_binary": null,
      "strategy": "process_group"
    },
    "mode": "Tui",
    "program": "<TMP>/bin/fake-harness"
  },
