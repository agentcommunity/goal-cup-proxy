{
  "argv_differs_from_policy": [],
  "ca": [
    {
      "file": "proxy_ca",
      "mode": "extend",
      "name": "CODEX_CA_CERTIFICATE",
      "value_in_plan": "<TMP>/proxy-ca.pem"
    }
  ],
  "capture_profile": {
    "args": [
      "-c",
      "check_for_update_on_startup=false",
      "-c",
      "projects={{ \"{workspace}\" = {{ trust_level = \"trusted\" }} }}",
      "-C",
      "{workspace}"
    ],
    "auth_hosts": [
      "auth.openai.com"
    ],
    "ca_env": [
      "CODEX_CA_CERTIFICATE"
    ],
    "config_home": "shared",
    "configure": [],
    "continuation": "chat: the participant types the prompt and may type keep going",
    "env": {
      "NODE_USE_ENV_PROXY": "1",
      "SHELL": "/bin/zsh"
    },
    "executable": {
      "version_args": [
        "--version"
      ]
    },
    "home": "empty",
    "hosts": [
      {
        "evidence_paths": [
          "/backend-api/codex/responses"
        ],
        "host": "chatgpt.com",
        "prefix_paths": [],
        "protocol_hint": "openai-responses"
      }
    ],
    "identity": {
      "binding": null,
      "grammar": null,
      "id_field": null,
      "match_field": null,
      "match_value": null,
      "prefix": null,
      "source": "none"
    },
    "interactive": true,
    "platform": {
      "linux-aarch64": {
        "env": {
          "SHELL": "/bin/bash"
        }
      },
      "linux-x86_64": {
        "env": {
          "SHELL": "/bin/bash"
        }
      }
    },
    "providers": [],
    "resume_args": [
      "resume",
      "--last"
    ],
    "skills_dir": "skills"
  },
  "connector": {
    "dir_digest_matches_its_pin": true,
    "files_dir": [],
    "id": "codex-cli",
    "launch_home_env": "CODEX_HOME",
    "launch_program": "codex",
    "validates": "ok"
  },
  "env_differs_from_policy": [],
  "goal_placement_for_an_option_shaped_goal": {
    "argv_len": 6,
    "goal_index": null,
    "goal_prefix": null,
    "tail": [
      "-C",
      "<TMP>/workspace"
    ]
  },
  "home": {
    "kind": "shared",
    "per_run_tree": null
  },
  "plan": {
    "argv": [
      "-c",
      "check_for_update_on_startup=false",
      "-c",
      "projects={ \"<TMP>/workspace\" = { trust_level = \"trusted\" } }",
      "-C",
      "<TMP>/workspace"
    ],
    "capture": null,
    "cwd": "<TMP>/workspace",
    "env_base_keys": [],
    "env_remove": [],
    "env_set": {
      "CODEX_CA_CERTIFICATE": "<TMP>/proxy-ca.pem",
      "CODEX_HOME": "<TMP>/harness-home",
      "GOALCUP_IN_HARNESS": "1",
      "GOALCUP_TIME_LEFT_FILE": "<TMP>/time-left/entry-0001",
      "HOME": "<TMP>/run-home",
      "HTTPS_PROXY": "<PROXY_URL>",
      "LOGNAME": "participant",
      "NODE_USE_ENV_PROXY": "1",
      "NO_PROXY": "127.0.0.1,localhost",
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "SHELL": "/bin/zsh",
      "TMPDIR": "/private/tmp/participant-tmp/",
      "USER": "participant",
      "https_proxy": "<PROXY_URL>",
      "no_proxy": "127.0.0.1,localhost"
    },
    "kill": {
      "grace_seconds": 10,
      "native_binary": "codex",
      "strategy": "native_pid"
    },
    "mode": "Tui",
    "program": "<TMP>/bin/fake-harness"
  },
  "redaction": {
    "extra_patterns": [
      {
        "kind": "codex_rate_limits",
        "regex": "\"rate_limits\"\\s*:\\s*(\\{(?:[^{}]|\\{(?:[^{}]|\\{[^{}]*\\})*\\})*\\})"
      },
      {
        "kind": "codex_plan_type",
        "regex": "\"plan_type\"\\s*:\\s*\"([^\"\\\\]+)\""
      },
      {
        "kind": "codex_credits_remaining",
        "regex": "\"credits_remaining\"\\s*:\\s*(\"[^\"\\\\]*\"|[^,}\\s]+)"
      },
      {
        "kind": "codex_credits",
        "regex": "\"credits\"\\s*:\\s*(\\{(?:[^{}]|\\{(?:[^{}]|\\{[^{}]*\\})*\\})*\\})"
      },
      {
        "kind": "codex_installation_id",
        "regex": "\"x-codex-installation-id\"\\s*:\\s*(\"[^\"\\\\]*\"|[^,}\\s]+)"
      },
      {
        "kind": "codex_safety_identifier",
        "regex": "\"safety_identifier\"\\s*:\\s*(\"[^\"\\\\]*\"|[^,}\\s]+)"
      },
      {
        "kind": "codex_turn_state",
        "regex": "\"x-codex-turn-state\"\\s*:\\s*(\"[^\"\\\\]*\"|[^,}\\s]+)"
      }
    ]
  },
  "streams": {
    "decision": "Inherit",
    "pipes": {
      "stderr": false,
      "stdout": false
    }
  },
  "termination": {
    "kill": {
      "grace_seconds": 10,
      "native_binary": "codex",
      "strategy": "native_pid"
    },
    "registered_handle": {
      "argv": [
        "-c",
        "check_for_update_on_startup=false",
        "-c",
        "projects={ \"<TMP>/workspace\" = { trust_level = \"trusted\" } }",
        "-C",
        "<TMP>/workspace"
      ],
      "env_keys": [
        "CODEX_CA_CERTIFICATE",
        "CODEX_HOME",
        "GOALCUP_IN_HARNESS",
        "GOALCUP_TIME_LEFT_FILE",
        "HOME",
        "HTTPS_PROXY",
        "LOGNAME",
        "NODE_USE_ENV_PROXY",
        "NO_PROXY",
        "PATH",
        "SHELL",
        "TMPDIR",
        "USER",
        "https_proxy",
        "no_proxy"
      ],
      "grace_seconds": 10,
      "has_process_start": true,
      "native_binary": "codex",
      "native_pid_found": false,
      "pgid_is_pid": false,
      "program": "<TMP>/bin/fake-harness",
      "strategy": "native_pid"
    }
  }
}
