#!/usr/bin/env python3
"""The pad's table (PRD-12 section 9).

With no row.json under pad-out/, write connectors/tiers.toml from the committed pad-rows.jsonl (the seed if none); with rows, also pad-rows.jsonl and
PAD-RESULTS.md. `--release-check <commit>` reads only pad-rows.jsonl as committed at <commit>: exit 0 when the release
rows hold, 1 naming each missing or differing item, 2 on a usage error. Python 3.9: no tomllib.
"""
import json, re, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
PAD_OUT, TIERS = ROOT / "pad-out", ROOT / "connectors" / "tiers.toml"
ROWS_REL = "scripts/pad/rows/pad-rows.jsonl"
RESULTS = ROOT / "scripts/pad/rows/PAD-RESULTS.md"
CASES, CHECKS = ("direct", "gateway", "dodger"), ("C1", "C2", "C3", "C4", "C5", "C6")
CORE = ("claude-code-cli", "codex-cli", "hermes-cli")
GUARDED = ["crates/", "server/worker/src/", "connectors/", "Cargo.lock", "Cargo.toml", "rust-toolchain.toml",
           ":(exclude)connectors/tiers.toml", ":(glob,exclude)crates/*/tests/**"]  # tests are not in the binary
# The 16 connector ids, PRD-11 section 5.
CONNECTOR_IDS = ["amp-cli", "claude-code-cli", "cline-cli", "codex-cli", "copilot-cli", "crush-cli", "droid-cli",
                 "gemini-cli", "goose-cli", "hermes-cli", "kilo-cli", "kimi-code-cli", "openclaw-cli",
                 "opencode-cli", "opencode2-cli", "qwen-cli"]
HEAD = ["Started", "Case", "Mode", "Variant", "Result"] + list(CHECKS) + [
    "Wire / harness calls", "Subagents", "Tokens in / out", "Gaps", "Why"]
HEADER = "# Written by scripts/pad/table (PRD-12 section 9). Do not edit by hand.\n"

def toml_str(s): return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'

def render_tiers(tiers):
    """tiers: {connector id: (tier, version, os, reason)} -> tiers.toml text (PRD-10 T1)."""
    return HEADER + "\n" + "\n".join("[%s]\ntier = %s\nversion = %s\nos = %s\nreason = %s\n" % (
        cid, toml_str(t), toml_str(v), toml_str(o), toml_str(why)) for cid, (t, v, o, why) in sorted(tiers.items()))

def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(text.encode("utf-8"))

def g(d, k): return d.get(k) if isinstance(d, dict) else None
def started(r): return str(r.get("started") or "")
def is_fault(r): return bool(r.get("variant"))  # a cycle row's own crash and a connector copy are in it too
def kills(r): return any(str(s).startswith("kill-recorder") for s in r.get("variant") or [])

def latest(rows, want):
    got = [r for r in rows if want(r)]
    return max(got, key=started) if got else None

def tier_row(cids, case):
    """Rows that give or take a tier: full mode, no fault step. micro, cycle and fault rows never do."""
    return lambda r: (r.get("connector") in cids and r.get("case") == case and r.get("mode") == "full"
                      and not is_fault(r))

def harness_lines(cid, sha=None):
    """The harness file's stripped lines: as committed at sha when given, else the working tree. [] if absent."""
    rel = "scripts/pad/harnesses/%s.toml" % cid
    if sha:
        got = subprocess.run(["git", "-C", str(ROOT), "show", "%s:%s" % (sha, rel)], capture_output=True, text=True)
        text = got.stdout if not got.returncode else ""
    else:
        text = (ROOT / rel).read_text(encoding="utf-8") if (ROOT / rel).is_file() else ""
    return [ln.strip() for ln in text.splitlines()]

def passed(r):  # PASS, or every check PASS but C3 not exercised (Hermes sends no plant back: owner, ask 4, 3 Nov)
    c3 = [w for w in r.get("why") or [] if str(w).startswith("C3 INCONCLUSIVE")]
    return r.get("result") == "PASS" or (all(g(r.get("checks"), c) == "PASS" for c in CHECKS if c != "C3")
                                         and g(r.get("checks"), "C3") == "INCONCLUSIVE" and c3
                                         and all("not exercised" in w or "exercise not done" in w for w in c3))

def counts(r): return passed(r) and not g(r.get("facts"), "masked_upstream") and not r.get("pad_only")

NO_TIER_ROW = {("claude-code-cli", "gateway")}  # the owner's 3 Nov exemption: no tier or release row for it
RELEASE_OS = "darwin-arm64"  # the release check's system for release_versions

def release_versions(lines):
    """`release_versions = ["<v>", ...]` (one line) in a harness file: the versions a release needs verified; [] if
    absent, None if the key is there but unreadable (the release check then refuses, never falls back)."""
    said = [ln for ln in lines if ln.startswith("release_versions")]
    m = re.fullmatch(r'release_versions\s*=\s*\[((?:\s*"[^"]+"\s*,?)*)\]\s*(#.*)?', said[0]) if said else None
    return (re.findall(r'"([^"]+)"', m.group(1)) or None if m else None) if said else []

def has_gateway(cid, rows, lines=None):
    # gateway is n/a, and does not block, when the harness file has no [gateway] table (no documented route).
    return "[gateway]" in (lines or harness_lines)(cid) or latest(rows, tier_row((cid,), "gateway")) is not None

def tier_for(cid, rows, lines=None):
    lines = lines or harness_lines  # looked up at call time
    # "not supported" is the watcher's decision (section 9), kept as `not_supported = "<reason>"` in the pad
    # harness file, never computed from rows.
    said = [m.group(1) for m in map(re.compile(r'not_supported\s*=\s*"(.*)"').fullmatch, lines(cid)) if m]
    if said:
        return ("not supported", "", "", said[0])
    # A stated reason (`not_verified = "<reason>"`) or no key (PRD-12 section 6) means the pad runs nothing, so
    # that reason is the cell, whatever old rows exist.
    why = [m.group(1) for m in map(re.compile(r'not_verified\s*=\s*"(.*)"').fullmatch, lines(cid)) if m]
    if why or 'key_kind = "none"' in lines(cid):
        return ("not verified", "", "", why[0] if why else "no key")
    if not any(r.get("connector") == cid for r in rows):
        return ("not verified", "", "", "not yet run on the pad")
    got = [(c, latest(rows, tier_row((cid,), c))) for c in CASES
           if (cid, c) not in NO_TIER_ROW and (c != "gateway" or has_gateway(cid, rows, lines))]
    reasons = []
    for _, r in got:
        if r and passed(r) and not counts(r):
            reasons.append((2, "%s masked upstream, not confirmed by the owner" % r.get("case") if g(r.get("facts"), "masked_upstream")
                            else "%s pad-only config: %s" % (r.get("case"), "; ".join(map(str, r["pad_only"])))))
        elif r and not counts(r):
            bad = next((c for c in CHECKS if g(r.get("checks"), c) != "PASS"), "result")
            why = [str(w) for w in r.get("why") or [r.get("result")]]
            first = next((w for w in why if w.startswith(bad + " ")), why[0])
            reasons.append((2, "%s %s %s" % (r.get("case"), bad, first.split(": ", 1)[-1])))
    reasons += [(3, "no full %s row" % c) for c, r in got if not r]
    pairs = {(str(r.get("harness_version") or ""), str(r.get("os") or "")) for _, r in got if r}
    reasons += [(4, "case rows on different versions or systems")] * (len(pairs) > 1)  # section 9: "on that version"
    reasons += [(4, "no harness version on a case row")] * ("" in {v for v, _ in pairs})  # P7: a named version
    reasons += [(4, "no system on a case row")] * ("" in {o for _, o in pairs})
    if reasons:
        return ("not verified", "", "", min(reasons, key=lambda x: x[0])[1])
    note = [m.group(1) for m in map(re.compile(r'tier_note\s*=\s*"(.*)"').fullmatch, lines(cid)) if m]
    return ("verified", *pairs.pop(), note[0] if note else "")

def cell(v):
    return "-" if v in (None, "", [], {}) else str(v).replace("|", "/").replace("\n", " ")

def run_cells(r, many):
    f, tok = r.get("facts") or {}, g(r.get("facts"), "tokens")
    variant = (r.get("variant") or []) + ["(%s %s)" % kv for kv in sorted((r.get("exec") or {}).items())]
    return ([started(r), ("%s " % r.get("connector")) * many + str(r.get("case")), r.get("mode"),
             " ".join(map(str, variant)), r.get("result")] + [g(r.get("checks"), c) for c in CHECKS]
            + ["%s / %s" % (g(f, "wire_requests"), g(f, "harness_calls")), g(f, "subagents"),
               "%s / %s" % (g(tok, "input"), g(tok, "output")),
               ", ".join("%s %s" % kv for kv in sorted((g(f, "gaps") or {}).items())),
               "" if r.get("result") == "PASS" else "; ".join(map(str, r.get("why") or []))])

def table(head, lines):
    return ["| " + " | ".join(head) + " |", "|" + "---|" * len(head)] + [
        "| " + " | ".join(cell(x) for x in ln) + " |" for ln in lines]

def results_md(rows, tiers):
    groups = {}
    for cid in CONNECTOR_IDS:  # OpenCode's two connectors share one harness line
        groups.setdefault("opencode" if cid.startswith("opencode") else cid, []).append(cid)
    summary, body = [], []
    for h, cids in sorted(groups.items()):
        tier = [("verified with a note: " + why if why else t) if t == "verified" else "%s: %s" % (t, why)
                for t, _, _, why in (tiers[c] for c in cids)]
        last = latest(rows, lambda r: r.get("connector") in cids)
        kill = latest(rows, lambda r: r.get("connector") in cids and kills(r)) if h in CORE else None
        summary.append([h, " / ".join(dict.fromkeys(tier)), " / ".join(dict.fromkeys(tiers[c][1] for c in cids))]
                       + [g(latest(rows, tier_row(cids, c)), "result") for c in CASES]
                       + [g(kill, "result"), started(last)[:10] if last else None])
        for title, fault in (("runs", False), ("fault and check runs", True)):
            sel = sorted((r for r in rows if r.get("connector") in cids and is_fault(r) == fault), key=started)
            body += ["", "## %s, %s" % (h, title), ""] + table(HEAD, [run_cells(r, len(cids) > 1)
                                                                    for r in reversed(sel)]) if sel else []
    return "\n".join(["# Pad results", "", "Written by scripts/pad/table (PRD-12 section 9) from pad-rows.jsonl. "
                      "Do not edit by hand.", ""] + table(["Harness", "Tier", "Version"] + list(CASES)
                                                         + ["Kill row", "Date"], summary) + body) + "\n"

def release_check(commit):
    def git(*a):
        return subprocess.run(["git", "-C", str(ROOT)] + list(a), capture_output=True, text=True)
    sha = git("rev-parse", "--verify", "-q", commit + "^{commit}").stdout.strip()
    if not sha:
        print("table: --release-check: %s is not a commit" % commit, file=sys.stderr)
        return 2
    shown, rows, items, used = git("show", sha + ":" + ROWS_REL), [], [], []
    if shown.returncode:
        return print("no committed %s at %s" % (ROWS_REL, sha)) or 1
    try:
        rows = [r for r in map(json.loads, shown.stdout.splitlines()) if isinstance(r, dict)]
    except ValueError:
        items.append("pad-rows.jsonl unreadable")

    def need(name, want, ok=counts,
             say=lambda r: "result %s%s" % (r.get("result"), ", C3 passed as masked upstream (owner has not confirmed)"
                                            if g(r.get("facts"), "masked_upstream") else ", pad-only config" if r.get("pad_only") else "")):
        r = latest(rows, want)
        if r is not None and ok(r):
            return used.append((name, r))
        items.append("%s: %s" % (name, "missing" if r is None else say(r)))
    for cid in CORE:  # release_versions in the harness file (owner, 4 Nov): each listed version on RELEASE_OS
        lines = harness_lines(cid, sha)
        vs = release_versions(lines)
        if not lines or vs is None:
            items.append("scripts/pad/harnesses/%s.toml %s at %s" % (cid, "release_versions unreadable (one line: [\"<v>\", ...])" if lines else "missing", sha))
        for v in vs or [None]:  # no key: the latest rows, any version
            for case in [c for c in CASES if (cid, c) not in NO_TIER_ROW]:
                want = tier_row((cid,), case)
                need("%s %s full%s" % (cid, case, " %s on %s" % (v, RELEASE_OS) if v else ""), want if v is None else
                     lambda r, w=want, v=v: w(r) and r.get("harness_version") == v and r.get("os") == RELEASE_OS)
    need("codex-cli direct full kill-recorder", lambda r: r.get("connector") == "codex-cli"
         and r.get("case") == "direct" and r.get("mode") == "full" and kills(r)
         and "connector copy" not in (r.get("variant") or []))  # section 9 means the shipped connector
    for s in ("h2-parallel.sh", "long-tunnel.sh"):  # the latest verdict for s, which must be PASS
        need("exec %s verdict PASS" % s, lambda r, s=s: g(r.get("exec"), s) is not None,
             ok=lambda r, s=s: r["exec"][s] == "PASS", say=lambda r, s=s: "verdict %s" % r["exec"][s])
    ran_on = {}  # the commit each relied-on row ran on, from goalcup "1.0.0+<commit>"
    for name, r in used:
        ran_on.setdefault(str(r.get("goalcup") or "").partition("+")[2], []).append(name)
    for c, names in sorted(ran_on.items()):
        d = git("diff", "--name-only", c, sha, "--", *GUARDED) if len(c) >= 7 and c.isalnum() else None
        if d is None or d.returncode:
            items.append("goalcup commit '%s' names no commit here: %s" % (c, ", ".join(names)))
        elif d.stdout.strip():
            items.append("%s differs from %s under %s: %s" % (
                c[:12], commit, ", ".join(d.stdout.split()[:5]), ", ".join(names)))
    tiers = git("show", sha + ":connectors/tiers.toml")
    if tiers.returncode:
        items.append("connectors/tiers.toml missing at %s" % sha)
    elif tiers.stdout != render_tiers({c: tier_for(c, rows, lambda c: harness_lines(c, sha)) for c in CONNECTOR_IDS}):
        items.append("connectors/tiers.toml differs from the rows; run scripts/pad/table and commit it")
    print("\n".join(items) if items else "release check: pass at %s" % sha)
    return 1 if items else 0

def main(argv):
    if len(argv) == 2 and argv[0] == "--release-check":
        return release_check(argv[1])
    if argv:
        print("usage: scripts/pad/table [--release-check <commit>]", file=sys.stderr)
        return 2
    rows, found = [], sorted(PAD_OUT.rglob("row.json")) if PAD_OUT.is_dir() else []
    for p in found:
        r = None
        try:
            r = json.loads(p.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            pass
        if isinstance(r, dict):
            rows.append(r)
        else:
            print("table: skipped unreadable %s" % p.relative_to(ROOT), file=sys.stderr)
    committed = not found and (ROOT / ROWS_REL).is_file()  # no pad-out: render the committed rows, rewrite nothing else
    if committed:
        rows = [r for r in map(json.loads, (ROOT / ROWS_REL).read_text(encoding="utf-8").splitlines()) if isinstance(r, dict)]
    tiers = {cid: tier_for(cid, rows) for cid in CONNECTOR_IDS}  # neither: the phase 0 seed
    write(TIERS, render_tiers(tiers))
    if found:
        lines = sorted(((str(r.get("connector") or ""), str(r.get("case") or ""), started(r)),
                        json.dumps(r, sort_keys=True, separators=(",", ":"))) for r in rows)
        write(ROOT / ROWS_REL, "".join(line + "\n" for _, line in lines))
        write(RESULTS, results_md(rows, tiers))
    print("table: %d of %d rows read; wrote %s%s" % (len(rows), len(found), TIERS.relative_to(ROOT),
                                                     ", %s, PAD-RESULTS.md" % ROWS_REL if found
                                                     else " (from %s)" % ROWS_REL if committed else " (seed)"))
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
