def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def append(path, doc):
    """One sorted JSON line, appended (watch/spend.jsonl, pad-out/spend.jsonl): names and numbers only."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with LEDGER, open(path, "a") as f:
        f.write(json.dumps(doc, sort_keys=True) + "\n")


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def queue_slot(name, pad, out_root, who):
    """Section 7, per key at once: pad-out/queue/<key name>/ holds one file per held slot (pid, start; the name only, never a value).
    Waits (a line a minute) until fewer than per_key (per_key_deepseek until queue.json says a row passed 5% 429) are held,
    reclaiming slots whose pid is dead. -> the slot file, or None when interrupted. No total cap (ledger B11)."""
    d = os.path.join(out_root, "queue", name)
    os.makedirs(d, exist_ok=True)
    quiet = 0
    while not STOP.is_set():
        with open(os.path.join(d, ".lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            held = []
            for f in sorted(x for x in os.listdir(d) if x.endswith(".slot")):
                try:
                    os.kill(int(f.split("-")[0]), 0)
                    held.append(f)
                except ProcessLookupError:
                    os.unlink(os.path.join(d, f))
                except PermissionError:
                    held.append(f)
            down = name in read_json(os.path.join(out_root, "queue.json")).get("downgraded", [])
            if len(held) < (pad.get("per_key_deepseek", 6) if name == "deepseek" and not down else pad.get("per_key", 2)):
                slot = os.path.join(d, "%d-%s.slot" % (os.getpid(), secrets.token_hex(3)))
                with open(slot, "w") as f:
                    json.dump({"pid": os.getpid(), "start": now(), "run": who}, f)
                return slot
        if quiet % 12 == 0:
            print("queued: %s waits for a free %s slot (%d held)" % (who, name, len(held)), flush=True)
        quiet += 1
        STOP.wait(5)


def downgrade_if_429(name, folder, out_root):
    """After a deepseek row: a 429 share over 5% of its wire requests drops the key to per_key for every later pad process."""
    facts = read_json(os.path.join(folder, "row.json")).get("facts") or {}
    n = sum(v for k, v in (facts.get("provider_errors") or {}).items() if ("429" in str(k) or "rate_limit" in str(k)) and isinstance(v, int))
    if name == "deepseek" and n and n > 0.05 * (facts.get("wire_requests") or 0):
        path = os.path.join(out_root, "queue.json")
        with open(path + ".lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            doc = read_json(path)
            doc["downgraded"] = sorted(set(doc.get("downgraded", [])) | {name})
            with open(path + ".tmp", "w") as f:
                json.dump(doc, f)
            os.replace(path + ".tmp", path)


def check_key_file(path, repo=REPO):
    """A regular file, no link, no group or world bits, outside the checkout (scripts/matrix.sh:92-104, :1015-1031)."""
    if os.path.islink(path) or not os.path.isfile(path):
        raise Refused("key file must be a regular file, not a link: %s" % path)
    if stat.S_IMODE(os.stat(path).st_mode) & 0o077:
        raise Refused("key file must be mode 0600: %s" % path)
    real, here = os.path.realpath(path), os.path.realpath(repo)
    if real == here or real.startswith(here + os.sep):
        raise Refused("key file is inside the checkout: %s" % path)
    return path


def check_push_token(path, repo=REPO):
    """The key file rule, then matrix.sh:1032-1041: one line, optional GH_TOKEN=, visible characters, no gho_ or ghp_."""
    check_key_file(path, repo)
    if os.path.getsize(path) > 4096:
        raise Refused("push token file is over 4 KiB")
    with open(path, encoding="utf-8", errors="replace") as f:
        lines = [ln for ln in f.read().split("\n") if ln.strip()]
    value = lines[0].strip() if len(lines) == 1 else ""
    value = value[len("GH_TOKEN="):] if value.startswith("GH_TOKEN=") else value
    if not re.fullmatch(r"[!#-&(-~]+", value):
        raise Refused("push token file must hold one token of visible characters, no quote or space")
    if value.startswith(("gho_", "ghp_")):
        raise Refused("push token is a gh login or classic token: give a fine-grained one")
    return path


EXEC_LIMIT = 15 * 60  # seconds an exec script may run (the longest, refusal-curl.sh, waits 11 minutes); pad-run kills it then


def parse_steps(steps):
    out = []
    for raw in steps:
        if not isinstance(raw, str):
            raise Usage("steps holds a value that is not a string")
        m = re.fullmatch(r"([a-z-]+)@(\d+)(?:\+(\d+|upload))?", raw)
        if m and m.group(1) in FAULTS:
            kind, extra = m.group(1), m.group(3)
            if extra and not (kind in SPAN and extra.isdigit() or kind == "kill-both" and extra == "upload"):
                raise Usage("step %r: no such suffix for %s" % (raw, kind))
            out.append(("timed", int(m.group(2)), raw))
        elif re.fullmatch(r"exec [A-Za-z0-9._-]+@\d+|pre [A-Za-z0-9._-]+", raw):  # section 3.1
            if not os.path.isfile(os.path.join(HERE, "exec", raw.split()[1].split("@")[0])):
                raise Usage("step %r: no such script under scripts/pad/exec/" % raw)
            out.append(("timed", int(raw.rsplit("@", 1)[1]), raw) if raw.startswith("exec") else ("pre", 0, raw))
        elif raw == "keep-going":
            out.append(("keep-going", 0, raw))
        elif re.fullmatch(r"wait-calls \d+", raw):  # P14 forces a timeout with `wait-calls 999`
            out.append(("calls", int(raw.split()[1]), raw))
        else:
            raise Usage("unknown step %r" % raw)
    return out


def load_settings(raw, pad):
    """Settings dict (already parsed) to a full settings dict, or Usage."""
    unknown = sorted(set(raw) - KEYS)
    if unknown:
        raise Usage("unknown setting: %s" % ", ".join(unknown))
    for k in ("harness", "key", "mode"):
        if not isinstance(raw.get(k), str):
            raise Usage("%s is required" % k)
    if not NAME.fullmatch(raw["harness"]):
        raise Usage("bad harness id")
    if raw["mode"] not in MODES:
        raise Usage("mode is micro, cycle or full")
    s = {"case": "direct", "where": "sandbox", "steps": [], "keep": True, "keep_going": 1, "keep_going_count": 1, "gateway_key": "gateway",
         **MODES[raw["mode"]], **raw}
    if s["case"] not in ("direct", "gateway", "dodger", "all"):
        raise Usage("case is direct, gateway, dodger or all")
    if s["server"] != "off" and s["server"] not in (*SERVERS, "staging"):
        raise Usage("server is off, local or staging (there is no server address setting)")
    if s["where"] not in ("sandbox", "here"):
        raise Usage("where is sandbox or here")
    if "goalcup_home" in s and (s["where"] != "here" or not isinstance(s["goalcup_home"], str) or not os.path.isabs(os.path.expanduser(s["goalcup_home"]))):
        raise Usage("goalcup_home is an absolute path, and only with where = \"here\"")  # the signed-in home, kept as is
    if "goalcup_home" in s:
        s["goalcup_home"] = os.path.expanduser(s["goalcup_home"])
    if "model_host" in s and not re.fullmatch(r"[a-z0-9][a-z0-9.-]*", str(s["model_host"])):
        raise Usage("model_host is a host name")
    if "pre_keys" in s and not (isinstance(s["pre_keys"], list) and all(isinstance(k, str) for k in s["pre_keys"])):
        raise Usage("pre_keys is a list of strings")  # a signed-in home shows fewer first screens
    if s["key"] == "none" and s["case"] == "gateway":
        raise Usage("key none runs the direct or dodger case; a gateway row has its own settings file and key")
    if s["server"] == "local" and s["where"] == "sandbox":
        raise Usage("local server in a sandbox comes in a later slice")
    for k in ("key", "gateway_key"):
        if not (s[k] == "none" and k == "key") and not NAME.fullmatch(s[k]):
            raise Usage("bad %s name" % k)
        used = s["key"] != "none" and (k == "key" or s["case"] in ("gateway", "all"))
        if s["where"] == "sandbox" and used and not KEY_VAR.fullmatch(str(pad.get("keys", {}).get(s[k]))):
            raise Usage("%s %r: pad.toml [keys] must map it to a *_API_KEY variable" % (k, s[k]))
    if s["prompt"] not in ("micro", "smoke", "full") and not os.path.isfile(str(s["prompt"])):
        raise Usage("prompt is micro, smoke, full or a prompt file")
    for k in ("minutes", "keep_going", "keep_going_count"):
        if isinstance(s[k], bool) or not isinstance(s[k], (int, float)) or s[k] <= 0:
            raise Usage("%s is a number above 0" % k)
    if not isinstance(s["keep"], bool):
        raise Usage("keep is true or false")
    if "cap_usd" in s and (type(s["cap_usd"]) not in (int, float) or s["cap_usd"] <= 0):
        raise Usage("cap_usd is a number above 0")
    if "box_extra_minutes" in s and (type(s["box_extra_minutes"]) is not int or s["box_extra_minutes"] < 0):
        raise Usage("box_extra_minutes is a whole number, 0 or more")
    if "box_vcpus" in s and (type(s["box_vcpus"]) is not int or s["box_vcpus"] not in (1, 2, 4, 8)):
        raise Usage("box_vcpus is 1, 2, 4 or 8")
    for k in ("version", "build", "connector", "hosts"):
        if k in s and not isinstance(s[k], str):
            raise Usage("%s is a string" % k)
    if not isinstance(s["steps"], list):
        raise Usage("steps is a list")
    steps = s["steps"]
    if s["mode"] == "cycle":  # cycle owns its crash at 3; its stream wait and restart can run past 4:00
        steps = ["kill-recorder@3"] + [x for x in steps if x != "kill-recorder@3"]
    s["plan"] = parse_steps(steps)
    if s["mode"] == "cycle":
        for _, m, r in s["plan"]:
            if r.startswith(("kill-watchdog", "kill-both@")) and (m <= 4 or "recover" in r):
                raise Usage("step %r does not fit cycle's own crash at minute 3" % r)
    return s


def row_pad(s, pad):
    """A copy of pad.toml's values with the row's own cap_usd, box_extra_minutes and box_vcpus where it names them."""
    return dict(pad, **{k: s[k] for k in OVERRIDES if k in s})


KILL_PAIR = (8, 10)  # section 3.1: the kill-recorder pair a settings file names; a harness file's kill_minutes replaces it


def apply_kill_minutes(s, harness):
    """A harness file's `kill_minutes = [a, b]` (two ascending positive integers; absent: 8 and 10) replaces the
    kill-recorder@8 and @10 pair in the plan and the settings (a cycle run's own @3 counts once, so cycle with the pair
    kills twice). A run without that pair keeps its steps."""
    got = harness.get("kill_minutes", list(KILL_PAIR))
    if not (isinstance(got, list) and len(got) == 2 and all(type(x) is int and x > 0 for x in got) and got[1] - got[0] == 2):
        raise Usage("kill_minutes in the harness file is two whole minutes above 0, the second 2 after the first")
    old = ["kill-recorder@%d" % m for m in KILL_PAIR]
    steps = [r for _, _, r in s["plan"]]
    if all(r in steps for r in old):
        if got[1] >= s["minutes"]:
            raise Usage("kill_minutes in the harness file: the second kill (minute %d) is not before the run's %d minutes" % (got[1], s["minutes"]))
        new = dict(zip(old, ["kill-recorder@%d" % m for m in got]))
        s["plan"] = parse_steps(list(dict.fromkeys(new.get(r, r) for r in steps)))  # a cycle run's own @3 is not doubled
        s["steps"] = [new.get(r, r) for r in s["steps"]]  # the settings file pad-run reads names the same minutes


def lasts(raw):
    """Minutes the timed step `kind@m[+n]` lasts: its +n, else the kind's own (also for `kill-both@m+upload`)."""
    kind, _, rest = raw.partition("@")
    n = rest.partition("+")[2]
    return int(n) if n.isdigit() else FAULTS[kind]


def step_limit(s, step):
    """Seconds; the one owner of every step limit (pad-run's own come from it through runner_limits). wait-upload:
    10 min, or 5 after the last fault ends (minutes from the paste, so a wait from the seal never falls short). A timed
    `kind@m` is bounded from the step's start: m minutes, then pad-run's own limit for the kind, plus 2 minutes."""
    kind, _, at = step.partition("@")
    kind = kind.split(" ")[0]
    if at:  # kind@m, kind@m+n, kill-both@m+upload or exec <script>@m
        return int(at.split("+")[0]) * 60 + runner_limits(s).get(kind, 300) + 120
    if kind == "wait-upload":
        ends = [m + lasts(r) for _, m, r in s["plan"] if r.partition("@")[0] in FAULTS]
        return 60 * max(LIMITS[kind], 5 + max(ends, default=0))
    return LIMITS.get(kind, 5) * 60 + (s["minutes"] * 60 if kind in ("seal", "check", "keep-going") else 0)


def runner_limits(s):
    """Seconds per pad-run step, the ones pad-run reads from settings.json: paste has start's, verify works to the
    check step's limit, wipe to a third of cleanup's (the box's rm and list take the other thirds), and wait-recovery
    to 30 s under its step's limit (pad-run starts later, so its own FAIL line comes before the step times out). The
    faults and exec (EXEC_LIMIT) count from minute m; keep-going and the detached
    watch from their start."""
    got = {k: step_limit(s, k) for k in ("setup", "pre", "start", "wait-calls", "look", "seal", "wait-upload",
                                         "wait-recovery")}
    run = int(math.ceil(s["minutes"] * 60))
    got["wait-recovery"] -= 30
    longest = lambda k: 60 * max([lasts(r) for _, _, r in s["plan"] if r.startswith(k + "@")],  # noqa: E731
                                 default=FAULTS[k]) + 120  # the longest +n of the kind, then 2 minutes
    return dict(got, paste=got["start"], verify=step_limit(s, "check"), wipe=step_limit(s, "cleanup") // 3, spend=120,
                **{"kill-recorder": 420, "kill-watchdog-recover": 240, "kill-watchdog": 330, "kill-both": 300, "fd-limit": 60,
                   "keep-going": run, "seal-now": 120, "watch": run + 1800, "exec": EXEC_LIMIT}, **{k: longest(k) for k in SPAN})


def pin(data, host):
    """Section 2, dodger: a hosts file's bytes with `host` added to its one-line `pinned = [...]`, or Refused."""
    try:
        text = re.sub(r"(?m)^pinned\s*=\s*\[(.*)\]", lambda m: "pinned = [%s]" % ", ".join(
            filter(None, [m[1].strip().rstrip(","), json.dumps(host)])), data.decode(), count=1)
        pinned = tomllib.loads(text).get("pinned")
        if isinstance(pinned, list) and host in pinned:
            return text.encode()
    except ValueError:  # not UTF-8, or not TOML
        pass
    raise Refused("dodger: %s is not in the hosts copy's pinned list" % host)


def price(models, rates, key):
    """Section 7: check.py's `models` ([{model, tokens}], int or null counts) at pad.toml's [rates] in USD per million
    -> (USD, sorted models with no rate line). Those are priced at the highest rate listed for `key`, or the highest
    overall when the key has no line. A rate line with no cache_write prices cache writes at its input rate."""
    def rate(r, k):
        return float(r.get(k, r.get("input", 0)) if k == "cache_write" else r.get(k, 0))
    pool = [r for r in rates.values() if r.get("key") == key] or list(rates.values())
    high = {k: max([rate(r, k) for r in pool] or [0]) for k in PRICED}
    usd, unpriced = 0.0, set()
    for m in models:
        r, tok = rates.get(m.get("model")), m.get("tokens") or {}
        unpriced |= {str(m.get("model"))} if r is None else set()
        usd += sum((tok.get(k) or 0) * (rate(r, k) if r else high[k]) for k in PRICED) / 1e6
    return usd, sorted(unpriced)


def approve(server, code):
    """Section 3, 0:03: PRD-07's test approval, from this process. The key and the member id are read from the
    APPROVAL variables here at the call, and go into the request only."""
    key, member = map(os.environ.get, APPROVAL)
    if not (key and member):
        return "approval key or member id not set"
    req = urllib.request.Request(server_url(server) + "/v1/device/approve", method="POST", data=json.dumps(
        {"user_code": code, "member_id": member, "approve": True}).encode(),
        headers={"authorization": "Bearer " + key, "content-type": "application/json", "user-agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            status, body = r.status, b""
    except urllib.error.HTTPError as e:
        status, body = e.code, e.read()
    except Exception as e:  # a network error: its class only, never the URL, query or headers
        return "approval failed: " + type(e).__name__
    if status == 200:
        return "approved"
    try:
        doc = json.loads(body)
    except ValueError:
        doc = None
    if isinstance(doc, dict):  # JSON: the error code only, never the rest of the body
        err = doc.get("error")
        tail = err if isinstance(err, str) and re.fullmatch(r"[a-z_]{1,40}", err) else ""
    else:  # not JSON: its first line, plain
        lines = body.decode("utf-8", "replace").strip().splitlines()
        tail = re.sub(r"[\x00-\x1f\x7f]", "", lines[0])[:80] if lines else ""
    return ("approval refused: HTTP %d %s" % (status, tail)).strip()


def step_list(s, harness):
    """Section 1a: the mode's steps, with the settings' steps added in time order."""
    plan = s["plan"]
    calls = [n for kind, n, _ in plan if kind == "calls"]
    timed = sorted(((m, r) for kind, m, r in plan if kind == "timed"), key=lambda t: t[0])
    seq = ["setup"] + [r for kind, _, r in plan if kind == "pre"]
    seq += ["start", "wait-calls %d" % (calls[-1] if calls else s["calls"]), "look"]
    seq += [x for _, r in timed for x in [r] + ["wait-recovery"] * r.startswith("kill-recorder@")]
    if any(kind == "keep-going" for kind, _, _ in plan) or s["mode"] == "cycle" and harness.get("keep_going") is True:
        seq.append("keep-going")
    return seq + ["seal"] + ["wait-upload", "fetch"] * (s["server"] != "off") + ["check", "cleanup"]


def end_screen_from_panes(folder):
    """The request count on the newest seal pane copy (watch/pane-s<n>.txt), as pad-run reads it; None when there is none."""
    panes = sorted(glob.glob(os.path.join(folder, "watch", "pane-s*.txt")),
                   key=lambda f: int(re.sub(r"\D", "", os.path.basename(f)) or 0))
    for f in reversed(panes):
        with open(f, errors="replace") as fh:
            found = re.findall(r"([\d,]+) requests? to model hosts written", fh.read())
        if found:
            return int(found[-1].replace(",", ""))
    return None


class Run:
    def __init__(self, s, case, pad, harness, out_root):
        self.s, self.case, self.pad, self.harness = s, case, pad, harness
        # tried: set before create, from then on cleanup removes the box by its name. create_late: create
        # hit its limit, the box may still appear after cleanup. meta: meta-box.json; row: check.py's result.
        self.tried = self.create_late = self.no_build = self.setup_failed = False
        self.name, self.lines, self.meta, self.row = "pad-" + secrets.token_hex(3), [], {}, None
        self.stray = []  # index boxes whose rm did not go
        self.fetched, self.kept = set(), {}  # entries whose server copy is here; entries rec/ was tried for: True, or why not
        self.build, self.pad_commit = None, head_commit(REPO)  # the build folder step_setup used; the pad's own commit
        self.tmp = tempfile.mkdtemp(prefix="pad-")  # box scripts; never in the run folder
        self.box_dir = None  # pad-run's run folder: here, or staged and pushed to the box's ~/run
        self.t0, self.out_root, self.over_cap, self.spender = time.time(), out_root, False, None
        self.usd, self.high, self.models, self.hosts_sha = None, [], [], None  # usage, set by the check step
        self.usd_live = None  # the last estimate the spend check read: the ledger's fallback for a run left unpriced
        self.spent = threading.Event()  # set when the seal step ends: the spend check stops
        self.price_key = s["gateway_key"] if case == "gateway" else s["key"]
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        self.dir = os.path.join(out_root, s["harness"], case, stamp + "-" + self.name)
        os.makedirs(self.dir)

    def log(self, what):
        """calls.log: what the pad called, with the box name or entry id, never a value."""
        with open(os.path.join(self.dir, "calls.log"), "a") as f:
            f.write("%s %s\n" % (time.strftime("%H:%M:%SZ", time.gmtime()), mask(what)))

    def sbx(self, verb, *args, limit=None, name=None, env=None):
        """One sbx call on this run's box, or on `name` (the short-lived index box); `env` only for the one put-env that
        carries DATABASE_URL, every other call gets env_without()."""
        name = name or self.name
        self.log("sbx %s %s" % (verb, name))
        return call(["node", SBX, verb] + list(args), timeout=limit, env=env_without() if env is None else env)

    def line(self, step, result, saw):
        at = int(time.time() - self.t0) // 60
        self.lines.append((step, result, "%d:%02d" % (at // 60, at % 60), saw))

    def key_names(self):
        s = self.s
        return [] if s["key"] == "none" else [s["key"]] + [s["gateway_key"]] * (self.case == "gateway")

    def walk(self):
        slots = []
        try:
            for name in sorted(set(self.key_names())):  # in order, so two runs never wait on each other's second key
                slots.append((name, queue_slot(name, self.pad, self.out_root, self.name)))
            self.t0 = time.time()  # a queue wait is not the run's time
            for step in step_list(self.s, self.harness)[:-1]:
                if STOP.is_set() or self.setup_failed:
                    self.line(step, "skip", "interrupted" if STOP.is_set() else "setup failed")
                    continue
                kind = step.split("@")[0].split(" ")[0]
                own = getattr(self, "step_" + kind.replace("-", "_"), None)
                try:
                    limit = step_limit(self.s, step)
                    self.line(step, *(own(step, limit) if own else self.step_box(step, limit) if kind in BOX_STEPS
                                      else ("skip", NEEDS_LATER)))
                except Exception as e:  # a rig error writes its line and the walk goes on
                    late = isinstance(e, subprocess.TimeoutExpired)
                    why = "no answer in %d min" % (limit // 60) if late else str(e) if isinstance(e, Refused) else type(e).__name__
                    self.setup_failed = kind == "setup"  # a failed setup skips every later step
                    self.line(step, "FAIL" if self.setup_failed else "timeout" if late else "error", why)
                if kind == "seal":
                    self.end_spend()
        finally:
            self.end_spend()
            try:
                self.line("cleanup", *self.step_cleanup())
            except Exception as e:
                self.line("cleanup", "error", "%s; box %s may be left" % (type(e).__name__, self.name))
            shutil.rmtree(self.tmp, ignore_errors=True)
            for name, slot in slots:
                if slot:
                    try:
                        os.unlink(slot)
                    except OSError:
                        pass
                    if name == self.price_key:  # only the key this row's model calls used
                        try:
                            downgrade_if_429(name, self.dir, self.out_root)
                        except (OSError, ValueError, TypeError, AttributeError):
                            pass
            try:  # section 7, the ledger: one line per run, also an interrupted or unpriced one (usd null, usd_live its
                # last live estimate, so the scribe's 200 and 400 USD notices still count a run that spent)
                append(os.path.join(self.out_root, "spend.jsonl"), {
                    "at": now(), "connector": self.s["harness"], "case": self.case, "mode": self.s["mode"], "key": self.price_key,
                    "run": self.meta.get("run"), "entry": self.meta.get("entry"), "usd": self.usd, "usd_live": self.usd_live,
                    "over_cap": self.over_cap,
                    "models": {m["model"]: m["tokens"] for m in self.models}, "priced_high": self.high,
                    "box_minutes": round((time.time() - self.t0) / 60, 1) if self.tried else 0})
            except OSError as e:
                self.line("cleanup", "error", "spend ledger not written: %s" % type(e).__name__)
        return self.finish()

    def step_setup(self, step, limit):
        s, deadline = self.s, time.time() + limit
        left = lambda: max(1, deadline - time.time())  # noqa: E731
        names = self.key_names()
        stage = self.box_dir = tempfile.mkdtemp(prefix="pad-run-", dir=None if s["where"] == "here" else self.tmp)
        if s["where"] == "here":  # pad-run works on 0600 copies in the run folder; ~/.pad-keys stays whole
            for name in names + ["push"] * os.path.lexists(os.path.expanduser("~/.pad-keys/push")):
                (check_push_token if name == "push" else check_key_file)(os.path.expanduser("~/.pad-keys/" + name))
            os.mkdir(os.path.join(stage, "keys"), 0o700)
            if s.get("build"):  # the build runs here too, never whatever goalcup is first on PATH
                if not os.path.isfile(os.path.join(REPO, s["build"], "goalcup")):
                    raise Refused("no goalcup in build %s" % s["build"])
                self.build = os.path.join(REPO, s["build"])
            for name in names:
                with open(os.path.expanduser("~/.pad-keys/" + name), "rb") as a, \
                        os.fdopen(os.open(os.path.join(stage, "keys", name), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as b:
                    shutil.copyfileobj(a, b)
        cpath = s.get("connector") or os.path.join(REPO, "connectors", s["harness"] + ".toml")  # PRD-11's flat file
        con = read_toml(cpath) if os.path.isfile(cpath) else {}
        shutil.copy(os.path.join(HERE, "prompts", s["prompt"] + ".txt") if s["prompt"] in ("micro", "smoke", "full")
                    else s["prompt"], os.path.join(stage, "prompt-source.txt"))
        if s.get("connector"):  # S16 files, passed to goalcup start from the run folder
            shutil.copy(s["connector"], os.path.join(stage, "connector.toml"))
        shared = os.path.join(REPO, "connectors", "model-hosts.toml")
        if any(kind == "pre" for kind, _, _ in s["plan"]):
            shutil.copy(shared, os.path.join(stage, "model-hosts.toml"))  # the pre scripts' own copy (section 3.1)
        hosts = s.get("hosts") or self.case == "dodger" and shared
        if hosts:  # section 2: a dodger pins the model host in its copy, never in the checkout
            with open(hosts, "rb") as f:
                data = pin(f.read(), self.harness["model_host"]) if self.case == "dodger" else f.read()
            with open(os.path.join(stage, "hosts.toml"), "wb") as f:
                f.write(data)
            self.hosts_sha = hashlib.sha256(data).hexdigest()
        with open(os.path.join(stage, "settings.json"), "w") as f:  # pad-run's input: names, never a value
            json.dump(dict({k: v for k, v in s.items() if k != "plan"}, harness_id=s["harness"], harness=self.harness,
                           session=self.name, limits=runner_limits(s), server_url=server_url(s["server"]),
                           case=self.case, version=s.get("version") or self.harness["version"], key_files=names,
                           route_key=names[-1] if names else None, home_vars=con.get("home") or {},
                           native=[{k: r.get(k) for k in ("name", "root", "pattern")} for r in con.get("native", [])],
                           ca_env=con.get("ca_env") or [],
                           **{k: k + ".toml" for k, v in (("connector", s.get("connector")), ("hosts", hosts)) if v}), f)
        if s["where"] == "sandbox":
            if not os.path.isfile(os.path.join(HERE, "image.id")):
                raise Refused("no pad image: scripts/pad/image.id")
            self.meta["image"], self.tried = open(os.path.join(HERE, "image.id")).read().strip(), True
            mins = math.ceil(s["minutes"]) + int(self.pad.get("box_extra_minutes", 30))
            try:
                r = self.sbx("create", "--name", self.name, "--minutes", str(mins), "--snapshot", self.meta["image"],
                             "--vcpus", str(self.pad.get("box_vcpus", 4)), limit=limit)
            except subprocess.TimeoutExpired:
                self.create_late = True
                raise
            if r.returncode:
                raise Refused(said("box not created", r))
            build = os.path.join(REPO, s.get("build") or self.pad.get("build", "pad-out/build"))
            self.build = build
            bins = [b for b in ("goalcup", "goalcup-verify") if os.path.isfile(os.path.join(build, b))]  # none: "no goalcup build"
            padstage = os.path.join(self.tmp, "pad-stage")
            stage_pad(padstage)
            for verb, args in [("push-dir", (os.path.join(padstage, "scripts", "pad"), "~/pad")), ("push-dir", (stage, "~/run"))] + [
                    ("put", ("~/bin/" + b, "--file", os.path.join(build, b), "--mode", "755")) for b in bins]:
                r = self.sbx(verb, self.name, *args, limit=left())
                if r.returncode:
                    raise Refused(said("%s not copied" % args[0], r))
            for name, var in ((n, self.pad["keys"][n]) for n in names):  # presence only; sbx.mjs reads the value
                if var not in os.environ or self.sbx("put-env", self.name, "~/run/keys/" + name, "--env", var, limit=left()).returncode:
                    raise Refused("key %s: %s is not set, or not copied" % (name, var))
        result, saw, _ = self.box("setup", left())
        self.no_build = result == "skip" and saw.endswith(NO_BUILD)
        if result != "ok" and not self.no_build:
            raise Refused(saw)
        return "ok", saw

    def box(self, step, limit, tag="PADSTEP", argv=None):
        """One pad-run step (in the box, or a subprocess here) -> (result, saw, its last `tag` line's dict). The
        entry and run ids it names go into meta."""
        if argv is None and self.s["where"] == "sandbox":
            fd, script = tempfile.mkstemp(suffix=".sh", dir=self.tmp)  # its own file: the spend check runs beside a step
            # A transport error with no PADSTEP line: the response may be lost after the step ran, and a kill, seal or paste
            # must never be sent twice. So ask the box whether this attempt (its PAD_ATTEMPT id) began; send it again only if not.
            aid = secrets.token_hex(6)
            with os.fdopen(fd, "w") as f:
                f.write("PAD_ATTEMPT=%s exec python3.11 ~/pad/pad-run ~/run %s\n" % (aid, step))
            for attempt in range(3):
                r = self.sbx("exec", self.name, "--script", script, limit=limit)
                out = (r.stdout or "") + (r.stderr or "")
                if ("%s " % tag) in (r.stdout or "") or not TRANSPORT.search(out) or attempt == 2:
                    break
                lost = self.attempt_state(aid)
                if lost is not None:
                    r = subprocess.CompletedProcess(r.args, 0, lost, "")
                    break
                self.log("sbx exec %s retry %d: transport error, the box never began %s" % (self.name, attempt + 1, step))
                time.sleep(EXEC_RETRY_WAIT)
        else:
            r = call(argv or [sys.executable, os.path.join(HERE, "pad-run"), self.box_dir] + step.split(), timeout=limit,
                     env=dict(env_without(), **({"PAD_BIN": self.build} if self.build else {})))  # here is the box, and check.py needs no organizer secret either
        got = [ln[len(tag) + 1:] for ln in (r.stdout or "").splitlines() if ln.startswith(tag + " ")]
        d = json.loads(got[-1]) if got else {"result": "error", "saw": said("%s: no %s line" % (step, tag), r)}
        self.meta.update({k: d[k] for k in ("entry", "run", "new_entry") if d.get(k)})
        return d.get("result", "error"), d.get("saw", ""), d

    def attempt_state(self, aid):
        """After a lost `sbx exec` response: what the box says of attempt `aid` -> the step's own PADSTEP line when it ended,
        None when the box never began it (safe to send again), else a PADSTEP error line (began, no result read: never again)."""
        fd, script = tempfile.mkstemp(suffix=".sh", dir=self.tmp)
        with os.fdopen(fd, "w") as f:
            f.write('f=~/run/attempts/%s; if [ -f $f.json ]; then echo "PADSTEP $(cat $f.json)"; elif [ -f $f.begin ]; then echo PADBEGUN; '
                    'else echo PADNONE; fi\n' % aid)
        for _ in range(8):
            r = self.sbx("exec", self.name, "--script", script, limit=60)
            if "PADNONE" in (r.stdout or ""):
                return None
            line = next((ln for ln in (r.stdout or "").splitlines() if ln.startswith("PADSTEP ")), None)
            if line:
                try:
                    json.loads(line[len("PADSTEP "):])
                    return r.stdout
                except ValueError:
                    pass  # began, the result not readable yet: ask again, never a result and never a resend
            time.sleep(EXEC_RETRY_WAIT)  # began and still running, or the box could not be asked
        return "PADSTEP " + json.dumps({"result": "error", "saw": "sbx exec response lost; the step began and no result could be read"})

    def step_box(self, step, limit):
        if self.no_build:
            return "skip", NO_BUILD
        if step == "start" and not self.spender:  # ledger T6: the cap holds from the moment the prompt may be typed,
            # whatever start returns or raises; pad-run's spend answers skip "not started" until the paste
            self.spender = threading.Thread(target=self.spend, daemon=True)
            self.spender.start()
        result, saw, d = self.box(step, limit + 120)  # pad-run works to `limit`
        if step == "start" and result == "ok" and self.s["server"] != "off":  # off: start pasted too
            self.log("approve " + self.name)  # section 3, 0:03; the device code stays out of the log and the table
            got = approve(self.s["server"], d.get("code"))
            if got != "approved":
                return "INCONCLUSIVE", got
            result, saw, _ = self.box("paste", limit + 120)
            saw = "approved, prompt pasted" if result == "ok" else saw
        return result, saw

    def spend(self):
        """Section 7 (ledger T6): every spend_every_min, pad-run's usage on the open entry, priced here, one line in
        watch/spend.jsonl (usd null and a calls.log line when usage was not read); at cap_usd a seal-now in the box, tried
        again at each later check until it seals. Never a check failure."""
        every, cap = 60 * float(self.pad.get("spend_every_min", 5)), float(self.pad.get("cap_usd", 10))
        while not (self.spent.wait(every) or STOP.is_set()):
            try:
                result, saw, d = self.box("spend", runner_limits(self.s)["spend"] + 120)
            except Exception as e:
                result, saw, d = "error", type(e).__name__, {}
            # pad-run normalized the S7 models already (pad-run spend): read its own PADSTEP key, never the seam's
            read, seal_now = d.get("read") is True, None
            models = [m for m in d.get("models") or [] if isinstance(m, dict) and isinstance(m.get("model"), str)]
            usd, high = price(models, self.pad.get("rates") or {}, self.price_key) if read else (None, [])
            if not read:
                self.log("spend not read: %s %s" % (result, saw))
            else:
                self.usd_live = round(usd, 2)
            if read and usd >= cap:  # seal-now, then again at every later check until it is sealed
                self.over_cap = True
                try:
                    seal_now, told, _ = self.box("seal-now", runner_limits(self.s)["seal-now"] + 120)
                except Exception as e:
                    seal_now, told = "error", type(e).__name__
                self.log("spend %.2f USD reached the %g USD cap: seal-now %s %s: %s" % (usd, cap, self.name, seal_now, told))
            append(os.path.join(self.dir, "watch", "spend.jsonl"), {
                "at": now(), "read": read, "usage_exit": d.get("exit"), "usd": None if usd is None else round(usd, 2),
                "priced_high": high, "models": {m["model"]: m.get("tokens") for m in models}, "seal_now": seal_now})
            if seal_now == "ok":
                return

    def end_spend(self):
        self.spent.set()
        if self.spender:
            self.spender.join(runner_limits(self.s)["spend"] + 240)

    def step_fetch(self, step, limit):
        """Section 3, 0:27: the index from a separate short-lived box that alone holds DATABASE_URL (the conductor cannot
        reach the database), fetch-run here on that index (R2 over HTTPS, no DATABASE_URL), then the copy in to the pad
        box's ~/run/fetched/<entry>/, where pad-run verify reads it. A fetch that does not finish
        leaves the entry's rec/ to step_cleanup (keep_rec), which runs after a timeout too."""
        if self.s["server"] != "staging":
            return "skip", NEEDS_LATER
        new = self.meta.get("new_entry")
        entries = [str(self.meta.get("entry"))] + ([new] if new else [])  # kill-both: both
        for entry in entries:
            if not re.fullmatch(r"e[0-9a-f]{16}", entry):
                return "FAIL", NOT + "no entry id"
        if not os.environ.get("DATABASE_URL"):
            return "FAIL", NOT + "DATABASE_URL is not set"
        fr = os.path.join(REPO, "scripts", "fetch-run.sh")
        try:
            texts = {"query.sql": fetch_block(fr, "SQL"), "conv.py": fetch_block(fr, "PY"), "install.sh": INDEX_INSTALL}
        except Refused as e:
            return "FAIL", NOT + str(e)
        files = {}
        for fname, text in texts.items():
            files[fname] = os.path.join(self.tmp, "dbf-" + fname)
            with open(files[fname], "w") as f:
                f.write(text)
        for entry in entries:
            self.log("fetch-run " + entry)
            got = os.path.join(self.dir, "fetched", entry)
            index = os.path.join(self.dir, "fetched-index", entry + ".json")
            # Here (the owner's machine) fetch-run.sh runs its read-only query itself; no index box.
            here = self.s["where"] == "here"
            why = None if here else self.fetch_index(entry, index, files, limit)
            if why:
                return "FAIL", why
            keep = {"CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"} | ({"DATABASE_URL"} if here else set())
            try:
                r = call(["sh", fr, "--bucket", STAGING_BUCKET, *([] if here else ["--index", index]),
                          entry, os.path.dirname(got)], timeout=limit,
                         env=env_without(set(NEVER_IN_BOX) - keep))
            finally:  # a timeout kills sh before its EXIT trap: its work folder goes here
                for left in glob.glob(os.path.join(os.path.dirname(got), ".fetch-run.*")):
                    shutil.rmtree(left, ignore_errors=True)
            if r.returncode or not os.path.isfile(os.path.join(got, "fetch.json")):  # a partial entry exits 0
                return "FAIL", said("server copy not fetched", r)
            self.fetched.add(entry)
            if self.s["where"] == "here":
                shutil.copytree(got, os.path.join(self.box_dir, "fetched", entry))
            elif self.sbx("push-dir", self.name, got, "~/run/fetched/" + entry, limit=limit).returncode:
                return "error", "fetched copy not copied in"
        return "ok", "fetched " + " and ".join(entries)

    def fetch_index(self, entry, index, files, limit):
        """fetch-run.sh's DATABASE_URL converter and read-only query run in their own box (pad-dbf-*), whose only secret is
        ~/.dburl (0600, deleted by the script); the index (no secret in it) is copied to `index`. The box is removed
        whatever happens; one that will not go is named in the cleanup line. None when it worked, else the FAIL line."""
        name, deadline = "pad-dbf-" + self.name[len("pad-"):], time.time() + limit

        def ix(verb, *args, **kw):  # one sbx call on the index box, inside the step's limit
            return self.sbx(verb, *args, limit=max(1, deadline - time.time()), name=name, **kw)
        idx = os.path.join(self.tmp, "dbf-idx-%s.sh" % entry)
        with open(idx, "w") as f:
            f.write(INDEX_QUERY % (entry, entry))
        try:
            r = ix("create", "--name", name, "--minutes", str(math.ceil(limit / 60) + 1), "--vcpus", "1")
            if r.returncode:
                return said(NOT + "index box not created", r)
            for fname, mode in (("query.sql", "644"), ("conv.py", "644"), ("install.sh", "755"), ("idx.sh", "755")):
                r = ix("put", name, "~/" + fname, "--file", idx if fname == "idx.sh" else files[fname], "--mode", mode)
                if r.returncode:
                    return said(NOT + "index box not set up", r)
            r = ix("exec", name, "--script", files["install.sh"], "--sudo")
            if r.returncode:
                return said(NOT + "no psql in the index box", r)
            r = ix("put-env", name, "~/.dburl", "--env", "DATABASE_URL", env=env_without(set(NEVER_IN_BOX) - {"DATABASE_URL"}))
            if r.returncode:
                return said(NOT + "index box has no database address", r)
            r = ix("exec", name, "--script", idx)
            if r.returncode:
                return said(NOT + "index query failed", r)
            r = ix("get", name, "~/idx/%s.json" % entry, index)
            if r.returncode:
                return said(NOT + "index not copied out", r)
            if not isinstance(read_json(index), list):
                return NOT + "the index is not a list"
            return None
        finally:  # always, a timeout included
            try:
                gone = not self.sbx("rm", name, limit=120, name=name).returncode
            except Exception:
                gone = False
            if not gone:
                self.log("sbx rm failed " + name)
                self.stray.append(name)  # the cleanup line retries it and says so

    def keep_rec(self, limit=300):
        """P0b: before the pad box goes, the entry's rec/ (the recorder's masked recording, less the run certificate key) is
        copied to rec-kept/<entry>/rec when the server copy was not fetched, so a refetch and a check can still finish C4.
        Not kept unless the row's C3 scans (record, box output) ran and found no known value: a masking failure must not put
        a raw key on the conductor. Never raises, never changes a result; the cleanup line says how it went."""
        if self.s["server"] != "staging":
            return
        seen = [pc.Run(self.dir, {}).hits(n) for n in ("secrets", "secrets-out")]
        why = None if seen == [0, 0] else "known value found by C3" if any(seen) else "no C3 result"
        for entry in [self.meta.get("entry"), self.meta.get("new_entry")]:
            if not entry or not re.fullmatch(r"e[0-9a-f]{16}", entry) or entry in self.fetched or entry in self.kept:
                continue
            if self.s["where"] != "here" and not self.tried:
                continue
            if why:
                self.kept[entry] = why
                continue
            dest = os.path.join(self.dir, "rec-kept", entry)
            try:
                if self.s["where"] == "here":
                    srcs = glob.glob(os.path.join(self.box_dir or "", "gc", "home", "runs", "*", entry, "rec"))
                    if not srcs:
                        raise Refused("no rec folder")
                    shutil.copytree(srcs[0], os.path.join(dest, "rec"), ignore=lambda d, names: [n for n in names if n == "run-ca.key" or (n == "goalcup" and d == srcs[0])])
                else:
                    fd, script = tempfile.mkstemp(suffix=".sh", dir=self.tmp)
                    with os.fdopen(fd, "w") as f:
                        f.write(REC_TAR % (entry, entry))
                    if self.sbx("exec", self.name, "--script", script, limit=limit).returncode:
                        raise Refused("no rec folder in the box")
                    tar = os.path.join(self.tmp, "rec-kept-%s.tar" % entry)
                    if self.sbx("get", self.name, "~/rec-kept-%s.tar" % entry, tar, limit=limit).returncode:
                        raise Refused("rec not copied out")
                    os.makedirs(dest)
                    extract(tar, dest)
                    os.remove(tar)
                self.kept[entry] = True
            except Exception as e:
                shutil.rmtree(dest, ignore_errors=True)
                self.kept[entry] = str(e) if isinstance(e, Refused) else type(e).__name__

    def end_screen_fallback(self):
        if self.meta.get("end_screen_requests") is None:  # the seal step's transport failed: its pane copy still holds the end screen
            self.meta["end_screen_requests"] = end_screen_from_panes(self.dir)

    def step_check(self, step, limit):
        """Section 8: pad-run verify (sized to the run, it always writes its tar), the tar copied out, meta.json,
        then check.py's PADCHECK line."""
        self.box("verify", limit + 120)
        tar = os.path.join(self.dir, "box.tar")
        if self.s["where"] == "here":
            shutil.copy(os.path.join(self.box_dir, "out.tar"), tar)
        elif self.sbx("get", self.name, "~/run/out.tar", tar, limit=300).returncode:
            return "error", "results not copied out"
        extract(tar, self.dir)
        os.remove(tar)
        with open(os.path.join(self.dir, "meta-box.json")) as f:
            self.meta.update(json.load(f))  # pad-run's keys, merged whole; pad's own keys below win
        self.end_screen_fallback()
        s, at = self.s, datetime.datetime.fromtimestamp(self.t0, datetime.timezone.utc).isoformat(timespec="seconds")
        use = pc.load(self.dir, "verify/usage/%s.json" % self.meta.get("entry"))  # priced as the spend check does
        if isinstance(pc.dig(use, "s7_models"), list):  # as the live check: no models read is never priced as 0 USD
            self.models = pc.models(use)
            usd, self.high = price(self.models, self.pad.get("rates") or {}, self.price_key)
            self.usd = round(usd, 2)
        with open(os.path.join(self.dir, "meta.json"), "w") as f:
            json.dump(dict(self.meta, spend_usd_est=self.usd, priced_high=self.high, over_cap=self.over_cap, connector=s["harness"],
                           case=self.case, mode=s["mode"], prompt=s["prompt"], variant=self.variant(), where=s["where"],
                           server=s["server"], keep=s["keep"], minutes=s["minutes"],
                           started=at, push="not tested", pad_trusted_at=None, pad_commit=self.pad_commit,
                           goalcup=goalcup_id(REPO, build_commit(self.build)) if self.build else None,
                           os=os_id(s["where"]), steps=[list(ln) for ln in self.lines],
                           hosts_sha256=self.hosts_sha, model_host=self.harness.get("model_host"),
                           pinned_model=pinned_model(self.harness, self.case),
                           redacts_tool_output=self.harness.get("redacts_tool_output") is True,
                           redacts_kinds=list(self.harness.get("redacts_kinds") or []),
                           subagents_by_task_log=self.harness.get("subagents_by_task_log") is True),
                      f, indent=1, sort_keys=True)
        self.scan_out()
        result, saw, _ = self.box(step, 300, "PADCHECK", [sys.executable, os.path.join(HERE, "check.py"), self.dir])
        self.row = result if result in ("PASS", "FAIL", "INCONCLUSIVE") else None
        return result, saw

    def scan_out(self, top=None, name="secrets-conductor.json"):
        """Section 7 and C3: the conductor's scan of its run folder (or `top`) for the raw values of its own secrets (8
        characters or more, as pad-run's forms). Only the count is written, to verify/<name>; check.py reads the default."""
        values, hits = [v.encode() for v in map(os.environ.get, NEVER_IN_BOX) if v and len(v) >= 8], 0
        for root, _, files in os.walk(top or self.dir):
            for fname in files:
                with open(os.path.join(root, fname), "rb") as f:
                    data = f.read()
                hits += sum(data.count(v) for v in values)
        os.makedirs(os.path.join(self.dir, "verify"), exist_ok=True)
        with open(os.path.join(self.dir, "verify", name), "w") as f:
            json.dump({"hits": hits}, f)
        return hits

    def step_cleanup(self):
        """Section 3.2: pad-run wipe, box removed by name, then a list to confirm. Never changes a result."""
        saw, third, loose, wiped_ok = [], runner_limits(self.s)["wipe"], [], False
        try:  # the keys go first, then the recording is kept (the wipe leaves rec/ alone)
            result, wiped, _ = self.box("wipe", third) if self.tried or self.s["where"] == "here" and self.box_dir else ("ok", "")
            wiped_ok = result == "ok"
            saw += [wiped if result == "ok" else "wipe %s: %s" % (result, wiped)] if wiped else []
        except Exception as e:
            saw.append("wipe %s" % type(e).__name__)
        try:
            if wiped_ok:  # keys gone first; each call bounded by the wipe's share of the cleanup budget
                self.keep_rec(third)  # a fetch that failed, timed out or never ran still keeps a clean recording
            else:
                saw.append("rec not kept: wipe did not finish")
            if any(v is True for v in self.kept.values()):  # scanned after the row: its count is verify/secrets-kept.json
                if self.scan_out(os.path.join(self.dir, "rec-kept"), "secrets-kept.json"):
                    saw.append("kept rec has a conductor secret value")
        except Exception as e:
            saw.append("rec copy %s" % type(e).__name__)
        saw += ["rec kept for %s" % k if v is True else "rec not kept for %s: %s" % (k, v) for k, v in self.kept.items()]
        for n in self.stray:  # an index box whose rm in the fetch did not go: once more, and said either way
            try:
                if self.sbx("rm", n, limit=third, name=n).returncode:
                    raise Refused("rm failed")
                saw.append("index box %s removed" % n)
            except Exception:
                loose.append(n)
                saw.append("left: index box %s (holds the database address until its timeout)" % n)
        ok = "left" if loose else "ok"
        if not self.tried:
            shutil.rmtree(self.box_dir or self.tmp, ignore_errors=True)
            return ok, ", ".join(saw + ["no box"])
        try:
            r = self.sbx("rm", self.name, limit=third)
            saw.append("rm exit %d" % r.returncode if r.returncode else "box removed")
        except Exception as e:
            saw.append("rm %s" % type(e).__name__)
        try:
            r = self.sbx("list", "--prefix", "pad-", limit=third)
            names = (self.name, "pad-dbf-" + self.name[len("pad-"):])  # the run box and its index box
            boxes = [b for b in (json.loads(x) for x in r.stdout.splitlines() if x.startswith("{")) if b.get("name") in names] \
                if r.returncode == 0 else [{"name": self.name, "status": "unknown"}]
            live = [b for b in boxes if b.get("status") not in ("stopped", "deleted", "failed")]
            if not live:
                late = ["create timed out, box may appear until its timeout"] if self.create_late else []
                return ok, ", ".join(saw + ["list shows no live box"] + late)
            saw.append(said(", ".join("left: %s %s" % (b.get("name"), b.get("status")) for b in live), r))
        except Exception as e:
            saw.append("list %s, box %s may be left" % (type(e).__name__, self.name))
        return "left", ", ".join(saw)

    def variant(self):
        """The row's `variant` (section 8): faults, exec and pre scripts, a cycle row's own crash too, and a
        connector copy (P13: a check row, never a tier row)."""
        return [st for st in step_list(self.s, self.harness) if st.split("@")[0] in FAULTS or st.startswith(("exec ", "pre "))
                ] + ["connector copy"] * bool(self.s.get("connector"))

    def finish(self):
        """table.txt only: row.json and report.txt are check.py's (PRD-12 "Files it owns")."""
        s, secs = self.s, int(time.time() - self.t0)
        result = self.row or ("FAIL" if any(r == "FAIL" for _, r, _, _ in self.lines) else "INCONCLUSIVE")
        head = "pad %s %s %s   variant %s   run %s  entry %s  box %s   %dm %02ds" % (
            s["harness"], self.case, s["mode"], ",".join(self.variant()) or "-", self.meta.get("run") or "-",
            self.meta.get("entry") or "-", self.name if self.tried else "-", secs // 60, secs % 60)
        rows = [head, FMT % ("step", "result", "at", "saw")] + [FMT % ln for ln in self.lines]
        rows.append("%-17s %-14s %s" % ("result", result, os.path.relpath(self.dir, REPO) + "/"))
        table = "\n".join(rows) + "\n"
        with open(os.path.join(self.dir, "table.txt"), "w") as f:
            f.write(table)
        return result, table


def case_list(s, harness):
    """-> (cases to run, gateway n/a). Section 2: a harness with no documented gateway route gets n/a, never a made-up config."""
    cases = ["direct", "gateway", "dodger"] if s["case"] == "all" else [s["case"]]
    cases = [c for c in cases if not (s["key"] == "none" and c == "gateway")]  # no key: no gateway row, no n/a line
    na = "gateway" in cases and "gateway" not in harness
    return [c for c in cases if not (na and c == "gateway")], na


def run_all(s, pad, harness, out_root, cases):
    runs = [Run(s, c, pad, harness, out_root) for c in cases]
    with concurrent.futures.ThreadPoolExecutor(max_workers=1 if s.get("goalcup_home") else None) as ex:  # one signed-in home: one case at a time; waits stay signal-interruptible on POSIX, so STOP is still set
        return list(ex.map(Run.walk, runs))


def main(argv):
    if len(argv) != 2 or argv[1].startswith("-"):
        print("usage: scripts/pad/pad <settings file>", file=sys.stderr)
        return 2
    try:
        pad = read_toml(os.path.join(HERE, "pad.toml"))
        s = load_settings(read_toml(argv[1]), pad)
        harness = read_toml(os.path.join(HERE, "harnesses", s["harness"] + ".toml"))  # a missing one is an OSError
        harness = dict(harness, model_host=s.get("model_host", harness.get("model_host")))  # a sign-in calls another host
        if harness.get("key_kind") == "none" or harness.get("not_verified"):  # Amp, Droid: no key to give it; a row with a stated reason: nothing to run (no box, no case)
            print("%s: not verified: %s" % (s["harness"], harness.get("not_verified") or "no key"))
            return 3  # nothing proven: the INCONCLUSIVE exit, never "every row PASS"
        apply_kill_minutes(s, harness)
        pad = row_pad(s, pad)
        if not (harness.get("version") and harness.get("version_cmd")):
            raise Usage("scripts/pad/harnesses/%s.toml needs version and version_cmd" % s["harness"])
        if s["case"] in ("dodger", "all") and not re.fullmatch(r"[a-z0-9][a-z0-9.-]*", str(harness.get("model_host"))):
            raise Usage("case dodger: scripts/pad/harnesses/%s.toml needs model_host" % s["harness"])
    except (Usage, OSError, ValueError, TypeError) as e:
        print("pad: %s" % e, file=sys.stderr)
        return 2
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: STOP.set())
    cases, na = case_list(s, harness)
    results = run_all(s, pad, harness, os.path.join(REPO, "pad-out"), cases)
    sys.stdout.write("".join(table for _, table in results))
    if na:
        print("gateway n/a: %s has no documented gateway route" % s["harness"])
    got = [r for r, _ in results] or ["INCONCLUSIVE"]  # no row at all (gateway n/a) is never "every row PASS"
    return 1 if "FAIL" in got else 3 if "INCONCLUSIVE" in got else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
