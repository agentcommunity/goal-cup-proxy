def call(argv, timeout=None, env=None):
    """The one place the pad runs a command."""
    return subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout, env=env)


def extract(tar, dest):
    """A box tar unpacked under `dest` with the data filter (no path out of `dest`, no device files); no filter, no unpack."""
    if not hasattr(tarfile, "data_filter"):
        raise Refused("python has no tar data filter (3.11.4 or later needed)")
    with tarfile.open(tar) as t:
        t.extractall(dest, filter="data")


def stage_pad(dest, repo=REPO):
    """The tracked pad files (not rows, fixtures, runs or tests) copied under `dest`; their paths relative to `repo`."""
    out = call(["git", "-C", repo, "ls-files", "-z", "--", "scripts/pad"]).stdout.split("\0")
    keep = [p for p in out if p and not p.startswith(("scripts/pad/rows/", "scripts/pad/fixtures/", "scripts/pad/runs/"))
            and not os.path.basename(p).startswith("test_")]
    for p in keep:
        os.makedirs(os.path.dirname(os.path.join(dest, p)), exist_ok=True)
        shutil.copy2(os.path.join(repo, p), os.path.join(dest, p))
    return keep


def fetch_block(path, tag):
    """A heredoc body of fetch-run.sh, between its <<'TAG' line and the closing TAG line: one source, never copied.
    Refused when a marker is missing; the SQL block must also be BEGIN READ ONLY ... ROLLBACK."""
    with open(path) as f:
        lines = f.read().splitlines()
    starts = [i for i, ln in enumerate(lines) if ln.rstrip().endswith("<<'%s'" % tag)]
    ends = [i for i, ln in enumerate(lines) if ln == tag]
    if tag == "PY":  # the file has a second PY block, the converter is the first
        starts, ends = starts[:1], ends[:1]
    if len(starts) != 1 or len(ends) != 1 or ends[0] <= starts[0] + 1:
        raise Refused("fetch-run.sh has no single %s block" % tag)
    body = lines[starts[0] + 1:ends[0]]
    if tag == "SQL" and (not body[0].strip().upper().startswith("BEGIN READ ONLY") or body[-1].strip().upper() != "ROLLBACK;"):
        raise Refused("the SQL block in fetch-run.sh is not read-only")
    return "\n".join(body) + "\n"


