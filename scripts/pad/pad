def pinned_model(harness, case):
    """The main model the harness toml pins for this case (the dodger case uses the direct section), or None."""
    got = (harness.get("gateway" if case == "gateway" else "direct") or {}).get("model")
    return got if isinstance(got, str) and got else None

def build_commit(build_dir):
    """The 40-hex commit in `<build_dir>/commit`, or None. A folder named like a short commit (7 to 40 hex) must be
    a prefix of it: a stale file never lets a row claim a commit it did not run."""
    try:
        with open(os.path.join(build_dir, "commit")) as f:
            got = f.readline().strip()
    except OSError:
        return None
    if not re.fullmatch(r"[0-9a-f]{40}", got):
        return None
    name = os.path.basename(os.path.normpath(build_dir))
    return got if not re.fullmatch(r"[0-9a-f]{7,40}", name) or got.startswith(name) else None


def goalcup_id(repo, commit):
    """`<version>+<commit>`, the version from the first `version = "..."` line of Cargo.toml at that commit, or None."""
    if not commit:
        return None
    try:
        r = subprocess.run(["git", "-C", repo, "show", commit + ":Cargo.toml"], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    got = re.search(r'^version = "(.*)"$', r.stdout, re.M) if r.returncode == 0 else None
    return got.group(1) + "+" + commit if got else None


def os_id(where):
    """The OS a row ran on: the box image for `sandbox`, else this machine."""
    return "linux-x86_64" if where == "sandbox" else platform.system().lower() + "-" + platform.machine()


def head_commit(repo):
    try:
        r = subprocess.run(["git", "-C", repo, "rev-parse", "HEAD"], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def hidden():
    """The values the pad never shows: the conductor's organizer secrets and the parts of DATABASE_URL (host, user,
    password), read from the environment at call time. Empty and very short parts are skipped."""
    vals = [os.environ.get(k, "") for k in NEVER_IN_BOX]
    try:
        u = urllib.parse.urlsplit(os.environ.get("DATABASE_URL", ""))
        vals += [u.hostname, u.username, u.password]
    except ValueError:
        pass
    return sorted({v for v in vals if v and len(v) >= 4}, key=len, reverse=True)


def mask(text):
    """`text` with every hidden value replaced, longest first."""
    for v in hidden():
        text = text.replace(v, "<hidden>")
    return text


def said(what, r):
    """`what`, then the child's last stderr line, masked and then cut (a value cut in half is not left behind)."""
    tail = (r.stderr or "").strip().splitlines()
    return what + (": " + mask(tail[-1])[:160] if r.returncode and tail else "")


def env_without(hide=NEVER_IN_BOX):
    """The conductor's environment less `hide`: every child the pad starts gets this, never the whole (section 7)."""
    return {k: v for k, v in os.environ.items() if k not in hide}


