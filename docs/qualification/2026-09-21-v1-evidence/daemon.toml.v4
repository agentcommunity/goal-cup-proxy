# ---------------------------------------------------------------------------------------
# Added BY HAND, 2026-09-21. install-assisted.sh writes neither block
# (packaging/macos/install-assisted.sh:279-288); without them the daemon takes the legacy
# receipt-binding fallback, no FinalizationV1::WorkspaceSubmission record is written, and
# no TerminationOutcomeV1 reaches the trace — which is exactly what made the three
# 2026-09-17 journeys prove nothing. Recorded as a deviation; step 6 (d) fixes the
# installer so this edit stops being needed.
# Values from docs/qualification/2026-09-18-v4-daemon.toml.example; the window is unchanged
# because 2026-09-21 already falls inside it.
# ---------------------------------------------------------------------------------------

[event]
