config_dir = "/Users/you/goalcup-v4/cfg"
workspace_parent = "/Users/you/goalcup-v4/workspaces"
control_addr = "127.0.0.1:7797"
upload_url = "http://127.0.0.1:7799"
server_public_key = "6e7a1cdd29b0b78fd13af4c5598feff4ef2a97166e3ca6f2e4fbfccd80505bf1"

[event]
t0 = "2026-09-17T00:00:00Z"
start_window_closes_at = "2026-09-25T00:00:00Z"
rules_version = "rules-2026-09-17"

[receipt_binding]
mode = "workspace_submission"
questionnaire_version = "goal-cup-2026-v1"
